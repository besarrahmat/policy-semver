{
  "name": "policy-semver",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "pnpm -r --if-present run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^24.0.0",
    "only-allow": "^1.2.1",
    "tsx": "^4.23.9",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
