{
  "name": "policy-semver-monorepo",
  "version": "1.0.3",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixtures": "node --import tsx packages/cli/src/bin.ts test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "pnpm -r --if-present run build",
    "policy-semver": "node packages/cli/dist/bin.js",
    "sync:schema": "cp schemas/versioning.config.schema.json packages/core/src/config/versioning.config.schema.json",
    "prebuild": "pnpm sync:schema"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "only-allow": "^1.2.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
